# AI Script Writer — every variable by name, no real values.
# CI fails if a required variable is undocumented here (spec 13.3).
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------- application service (Node + Express) ----------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/ai_script_writer

JWT_SECRET=
JWT_EXPIRES_IN=86400

# Node -> AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=45000

# per-creator generation quota (spec 9.4 — unbounded generation is a cost leak)
GENERATION_RATE_LIMIT_PER_MIN=5
GENERATION_QUOTA_PER_DAY=50

# ---------- AI service (Python + FastAPI) ----------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# provider. LLM_PROVIDER=stub costs nothing and is the default for dev + CI.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=40
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=4000

EMBEDDING_PROVIDER=stub
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# retrieval knobs — config, not code (spec 13.3), so tuning needs no deploy.
RETRIEVAL_TOP_K=6
# Similarity on a normalised 0..1 scale: 0.5 = unrelated, 1.0 = identical.
# This is NOT raw cosine. See the note at the top of ai-service/app/rag/
# vector_store.py — every store normalises to this scale so the threshold means
# the same thing whichever store is in use. Calibrate in W3 against real
# embeddings; 0.70 is a starting point, not a measured value.
RETRIEVAL_MIN_SCORE=0.70
PROMPT_TOKEN_CAP=6000
BRIEF_MAX_CHARS=5000
KNOWLEDGE_DOC_MAX_CHARS=100000

# vector store: memory | mongo
# "mongo" = MongoDB Atlas Vector Search, which lives in the same cluster as the
# application data, so there is no second vector service to run.
VECTOR_STORE=memory
VECTOR_INDEX_NAME=knowledge_vector_index
# Only read when VECTOR_STORE=mongo. Same cluster as MONGODB_URI above; the AI
# service touches the chunk collection only.
AI_MONGODB_URI=
AI_MONGODB_DB=ai_script_writer

# ---------- client (React + Vite) ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
